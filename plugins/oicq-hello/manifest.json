{
  "id": "oicq-hello",
  "name": "示例插件",
  "version": "1.1.0",
  "description": "演示命令注册、拦截器、按路由渲染贡献与可拆卸生命周期",
  "api": 2,
  "main": "main.js",
  "permissions": ["storage"],
  "contributes": {
    "renderer": {
      "*": "renderer.js",
      "#/setting/settings": "settings.js"
    },
    "commands": [
      {
        "id": "hello.say",
        "title": "打个招呼",
        "hint": "在宿主日志与界面里各留一条记录"
      }
    ]
  }
}
